# ---------------------------------------------------------------------------
# Optional. The app works with no configuration at all: the default engine runs
# Whisper inside the browser, and no audio ever leaves the machine.
#
# These keys only matter if you switch the engine to OpenAI or Groq in Settings.
# Copy this file to .env.local and fill in whichever you use.
# ---------------------------------------------------------------------------

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=
